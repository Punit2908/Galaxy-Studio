PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/galaxy-studio
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Supabase is used ONLY for image/video storage.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=galaxy-media

CLIENT_URL=http://localhost:5173

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-unique-password
SUPER_ADMIN_NAME=Galaxy Photography Admin
